# SpendSense — Environment Variables
# Copy this file to .env and fill in your values
# Never commit .env to git

# ── Required ─────────────────────────────────────────────────────────────────

# Anthropic API key — get yours at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ── Optional (override defaults) ─────────────────────────────────────────────

# Database file path (default: ./data/expenses.db)
# DATABASE_URL=sqlite:///./data/expenses.db

# Backend API port (default: 8000)
# API_PORT=8000

# Streamlit frontend port (default: 8501)
# FRONTEND_PORT=8501

# Default salary fallback — used when no income entry exists for a month
# Set this to your approximate net monthly take-home (used only as a fallback)
# DEFAULT_MONTHLY_INCOME=0
