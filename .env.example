# SpendSense — Environment Variables
# Copy this file to .env and fill in your values
# Never commit .env to git

# ── Required ─────────────────────────────────────────────────────────────────

# Anthropic API key — get yours at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your-key-here

# JWT Authentication — generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
# Must be set — backend refuses to start without it
JWT_SECRET_KEY=your-secret-key-here-generate-a-new-one-do-not-use-this

# ── Optional (override defaults) ─────────────────────────────────────────────

# Token expiry in minutes (default: 480 = 8 hours)
# JWT_EXPIRE_MINUTES=480

# Database file path (default: ./data/expenses.db)
# DATABASE_URL=sqlite:///./data/expenses.db

# Backend API port (default: 8000)
# API_PORT=8000

# Streamlit frontend port (default: 8501)
# FRONTEND_PORT=8501

# Default salary fallback — used when no income entry exists for a month
# DEFAULT_MONTHLY_INCOME=0

# ── Default Admin Account ─────────────────────────────────────────────────────

# Created automatically on first startup if no users exist
# Change ADMIN_PASSWORD immediately after first login
# ADMIN_EMAIL=admin@spendsense.local
# ADMIN_PASSWORD=changeme123
