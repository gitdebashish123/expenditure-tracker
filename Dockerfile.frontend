# ── SanchaySaathi Frontend — Dockerfile ──────────────────────────────────────
# Multi-stage build: Node (build React) → Nginx (serve static files)
#
# Stage 1 builds the Vite+React app into static files in /app/dist
# Stage 2 serves them via Nginx on port 80
#
# Build:  docker build -f Dockerfile.frontend -t sanchaySaathi-frontend:local \
#                      --build-arg VITE_API_BASE=http://localhost:8000 .
# Run:    docker run -p 80:80 sanchaySaathi-frontend:local
#
# NOTE: Streamlit (frontend/app.py) still runs alongside during migration.
#       Run it manually:  uv run streamlit run frontend/app.py --server.port 8501

# ── Stage 1: Build ────────────────────────────────────────────────────────────
FROM node:20-alpine AS builder
WORKDIR /app

# Copy package files first for layer cache — only re-installs when deps change
COPY frontend/react/package*.json ./
RUN npm ci --silent

# Copy source
COPY frontend/react/ .

# Inject API base URL at build time (Vite bakes it into the bundle)
# In Railway: set VITE_API_BASE=https://your-backend.up.railway.app
ARG VITE_API_BASE
ENV VITE_API_BASE=${VITE_API_BASE}

RUN npm run build

# ── Stage 2: Serve ────────────────────────────────────────────────────────────
FROM nginx:1.25-alpine

# Copy built static files
COPY --from=builder /app/dist /usr/share/nginx/html

# Copy Nginx config — handles React Router + static asset caching
COPY nginx/react.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
