# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Environment variables — NEVER commit these
.env
.env.local
.env.*.local

# Database — contains personal financial data
data/expenses.db
data/*.db
data/*.db-shm
data/*.db-wal

# Uploaded/imported files with personal data
monthly_expenditure.xlsx
*.xlsx

# macOS
.DS_Store

# IDE
.vscode/settings.json
.idea/

# Logs
*.log

# Test artifacts
.pytest_cache/
htmlcov/
.coverage

# TLS certificates — never commit private keys or self-signed certs
nginx/certs/*.crt
nginx/certs/*.key
nginx/certs/*.pem

# React frontend build artifacts
frontend/react/node_modules/
frontend/react/dist/
frontend/react/.vite/

# PWA auto-generated service worker (rebuilt on every deploy)
frontend/react/public/sw.js
frontend/react/public/workbox-*.js
frontend/react/public/sw.js.map
frontend/react/public/workbox-*.js.map
